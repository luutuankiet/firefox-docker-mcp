# Copy to docker/.env and fill in. docker/.env is gitignored.

# The one host address both stacks publish MCP and VNC on. Loopback by default.
# Set it to this host's tailnet IP (tailscale ip -4) to reach the browser from
# the tailnet and nothing else. Never 0.0.0.0: VNC has no password.
# FF_PUBLISH_ADDR=127.0.0.1

# Bearer token for the production stack's MCP endpoint on :8931. The endpoint
# is reachable from anything that can route to FF_PUBLISH_ADDR, so the stack refuses
# to start without one. Generate with: openssl rand -hex 24
MCP_PROD_HTTP_TOKEN=

# Released server version baked into the production image.
# MCP_VERSION=0.7.1

# Bearer token for the dev stack on :8941 (docker-compose.dev.yaml).
MCP_HTTP_TOKEN=firefox-dev
